<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="ShellSO" />
		<Option pch_mode="2" />
		<Option compiler="gcc" />
		<Build>
			<Target title="Debug">
				<Option output="bin/Debug/ShellSO" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Debug/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-g" />
					<Add directory="include" />
					<Add directory="../ProyectoSO" />
				</Compiler>
			</Target>
			<Target title="Release">
				<Option output="bin/Release/ShellSO" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Release/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-O2" />
					<Add directory="include" />
					<Add directory="../ProyectoSO" />
				</Compiler>
				<Linker>
					<Add option="-s" />
				</Linker>
			</Target>
		</Build>
		<Compiler>
			<Add option="-Wall" />
			<Add directory="/usr/include" />
		</Compiler>
		<Linker>
			<Add library="readline" />
			<Add directory="/usr/lib" />
		</Linker>
		<Unit filename="../CommandRecord.cpp" />
		<Unit filename="../CommandRecord.h" />
		<Unit filename="../Shell.cpp" />
		<Unit filename="../Shell.h" />
		<Unit filename="../main.cpp" />
		<Extensions />
	</Project>
</CodeBlocks_project_file>
